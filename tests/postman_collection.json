{
  "info": {
    "_postman_id": "d8d2c2c2-9b7e-4f71-9d6e-automatedapitest",
    "name": "Automated API Testing - Product API",
    "description": "Automated REST API tests using Postman and Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Service is healthy\", () => pm.expect(pm.response.json().status).to.eql(\"OK\"));",
              "pm.test(\"Response time below 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Get All Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Products array and count are valid\", () => {",
              " const json = pm.response.json();",
              " pm.expect(json.data).to.be.an(\"array\");",
              " pm.expect(json.count).to.eql(json.data.length);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get Product by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "1"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Laptop is returned\", () => pm.expect(pm.response.json().data.name).to.eql(\"Laptop\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Mouse\",\n  \"price\": 799,\n  \"category\": \"Accessories\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Product created and ID saved\", () => {",
              " const json = pm.response.json();",
              " pm.expect(json.data.name).to.eql(\"Test Mouse\");",
              " pm.collectionVariables.set(\"createdProductId\", json.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Verify Created Product",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{createdProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{createdProductId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created product can be fetched\", () => pm.expect(pm.response.json().data.name).to.eql(\"Test Mouse\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{createdProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{createdProductId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Test Mouse\",\n  \"price\": 899,\n  \"category\": \"Accessories\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Product updated\", () => {",
              " const p = pm.response.json().data;",
              " pm.expect(p.name).to.eql(\"Updated Test Mouse\");",
              " pm.expect(p.price).to.eql(899);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Reject Invalid Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"price\": -10,\n  \"category\": \"Accessories\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid data returns 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error message is present\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Delete Product",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{createdProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{createdProductId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Delete confirmation returned\", () => pm.expect(pm.response.json().message).to.eql(\"Product deleted\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Verify Deleted Product",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{createdProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{createdProductId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Deleted product returns 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Not found message returned\", () => pm.expect(pm.response.json().message).to.eql(\"Product not found\"));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "createdProductId",
      "value": ""
    }
  ]
}